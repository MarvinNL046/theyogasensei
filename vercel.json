{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/go/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://m.media-amazon.com https://images-na.ssl-images-amazon.com https://imagedelivery.net https://theyogasensei.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com; font-src 'self' data:; connect-src 'self' https://*.convex.cloud wss://*.convex.cloud https://api.resend.com https://vitals.vercel-insights.com https://va.vercel-scripts.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*).(js|css|woff2|woff|webp|avif|svg|png|jpg|jpeg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/free/:slug",
      "destination": "/lead-magnets/:slug.pdf"
    }
  ],
  "redirects": [
    {
      "source": "/guides/best-yoga-mats-2026",
      "destination": "/reviews/best-yoga-mats",
      "permanent": true
    },
    {
      "source": "/guides/manduka-yoga-mat",
      "destination": "/reviews/manduka-pro",
      "permanent": true
    },
    {
      "source": "/guides/jade-yoga-mat",
      "destination": "/reviews/jade",
      "permanent": true
    },
    {
      "source": "/guides/gaiam-yoga-mat",
      "destination": "/reviews/gaiam",
      "permanent": true
    },
    {
      "source": "/guides/lululemon-yoga-mat",
      "destination": "/reviews/lululemon",
      "permanent": true
    },
    {
      "source": "/guides/retrospec-solana-yoga-mat",
      "destination": "/reviews/retrospec",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
