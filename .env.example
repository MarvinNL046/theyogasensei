# Copy this file to .env.local for local dev and fill in real values.
# Never commit .env or .env.local — they are gitignored.

# --- Convex (lead capture only — subscribers + emailEvents) ---
# Get from `pnpm convex dev` on first run. VITE_ prefix exposes to client.
VITE_CONVEX_URL=
CONVEX_DEPLOYMENT=

# --- Resend (transactional email: double opt-in, welcome, lead-magnet delivery) ---
# Get from https://resend.com/api-keys after verifying the theyogasensei.com domain.
RESEND_API_KEY=

# --- Cloudflare Images (image variants: pin, og, card, thumb) ---
# Account hash is the public delivery prefix; token is the API token with
# Cloudflare Images write permission. Used by scripts/upload-image.ts.
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_IMAGES_TOKEN=

# --- Public site URL (used for canonical, sitemap, OG absolute URLs) ---
# Defaults to https://theyogasensei.com in production builds.
SITE_URL=https://theyogasensei.com
