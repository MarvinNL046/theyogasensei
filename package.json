{
  "name": "theyogasensei",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "pnpm typecheck && pnpm verify && pnpm generate-sitemap && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-frontmatter.ts && tsx scripts/verify-used-keywords.ts && tsx scripts/verify-review-gate.ts && tsx scripts/verify-affiliate-ui.ts && tsx scripts/verify-associates-compliance.ts && tsx scripts/verify-affiliate-destinations.ts",
    "verify:frontmatter": "tsx scripts/verify-frontmatter.ts",
    "verify:keywords": "tsx scripts/verify-used-keywords.ts",
    "verify:associates": "tsx scripts/verify-associates-compliance.ts",
    "verify:affiliate-destinations": "tsx scripts/verify-affiliate-destinations.ts",
    "verify:production": "tsx scripts/audit-production-output.ts",
    "content:status": "tsx scripts/content-status.ts",
    "content:cannibalization": "tsx scripts/check-cannibalization.ts",
    "content:assets": "tsx scripts/audit-inline-assets.ts",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "ping-indexnow": "tsx scripts/ping-indexnow.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-serif-jp": "^5.2.8",
    "@mdx-js/rollup": "^3.1.1",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.3",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.169.9",
    "@tanstack/react-router-devtools": "^1.166.20",
    "@tanstack/react-router-ssr-query": "^1.166.19",
    "@tanstack/react-start": "^1.167.72",
    "@tanstack/router-plugin": "^1.167.42",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.38.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "h3": "2.0.1-rc.22",
    "lucide-react": "^0.545.0",
    "next-themes": "^0.4.6",
    "nitro": "npm:nitro-nightly@3.0.1-20260512-093145-0498ce70",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "resend": "^6.12.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
