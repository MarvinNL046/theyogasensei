# Wacht 24 uur (1440 minuten) voordat een nieuw-gepubliceerde npm versie
# geinstalleerd mag worden. Beschermt tegen supply-chain worm-attacks zoals
# Mini Shai-Hulud (TanStack, mei 2026) waarbij malicious versies binnen
# 30 minuten gedetecteerd en gedeprecated werden. 24u geeft ruim detectie-
# tijd zonder bugfix releases te lang uit te stellen.
minimum-release-age=1440
